// SQLite is used deliberately for this POC: zero-setup for reviewers, while still
// giving real SQL, real indexes and real server-side filtering. SQLite has no native
// enum or JSON column types, so those fields are stored as String and constrained in
// TypeScript (see src/lib/domain.ts) and validated with Zod at every entry point.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  /// One of: ops | compliance | admin
  role      String
  createdAt DateTime @default(now())

  auditLogs AuditLog[]
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  /// e.g. feature_flag.update, refund.approve, kyc.status_change
  action     String
  entityType String
  entityId   String
  /// JSON-encoded snapshot of the row before the mutation (null for creates)
  before     String?
  /// JSON-encoded snapshot of the row after the mutation (null for deletes)
  after      String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String
  name        String
  description String
  enabled     Boolean  @default(false)
  /// One of: dev | staging | prod
  environment String
  updatedById String?
  updatedByName String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([key, environment])
  @@index([environment])
  @@index([enabled])
  @@index([key])
}

model RefundRequest {
  id            String    @id @default(cuid())
  customerRef   String
  /// Stored in minor units (cents) to avoid float rounding on money.
  amountCents   Int
  reason        String
  /// One of: pending | approved | denied
  status        String
  requestedAt   DateTime
  decidedById   String?
  decidedByName String?
  decidedAt     DateTime?

  @@index([status])
  @@index([amountCents])
  @@index([requestedAt])
  @@index([customerRef])
  @@index([status, requestedAt])
}

model KycApplicant {
  id            String    @id @default(cuid())
  fullName      String
  /// One of: pending | under_review | approved | rejected
  status        String
  submittedAt   DateTime
  // Fields below are considered sensitive: they are never selected for the `ops` role.
  dateOfBirth   DateTime
  country       String
  documentType  String
  documentRef   String
  riskNotes     String
  reviewedById   String?
  reviewedByName String?
  reviewedAt    DateTime?

  @@index([status])
  @@index([submittedAt])
}
